# SynLive 前端（Next.js）
# 单机部署：前端通过 Caddy 以同源相对路径访问后端。
# 用 corepack 启用 pnpm（对齐 package.json 的 packageManager），避免 next build 找不到 pnpm。
# REGISTRY：私有镜像仓库前缀（带尾斜杠），如 harbor-develop.zuzuche.net/dockerhub/
# NPM_REGISTRY：npm/corepack 源，国内默认 npmmirror；可由 .env 覆盖。
ARG REGISTRY=
ARG NPM_REGISTRY=https://registry.npmmirror.com

FROM ${REGISTRY}node:22-alpine AS deps
ARG NPM_REGISTRY
WORKDIR /app
ENV COREPACK_NPM_REGISTRY=$NPM_REGISTRY npm_config_registry=$NPM_REGISTRY
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

FROM ${REGISTRY}node:22-alpine AS builder
ARG NPM_REGISTRY
WORKDIR /app
ENV COREPACK_NPM_REGISTRY=$NPM_REGISTRY npm_config_registry=$NPM_REGISTRY
RUN corepack enable
COPY --from=deps /app/node_modules ./node_modules
COPY . .
ARG API_UPSTREAM=http://localhost:8000
ARG SRS_API_UPSTREAM=http://localhost:1985
ENV API_UPSTREAM=$API_UPSTREAM \
    SRS_API_UPSTREAM=$SRS_API_UPSTREAM
RUN pnpm run build

FROM ${REGISTRY}node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NODE_USE_ENV_PROXY=1
RUN apk add --no-cache ffmpeg
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
EXPOSE 3000
CMD ["node_modules/.bin/next", "start"]
