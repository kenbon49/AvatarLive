+def _session_state_snapshot(state: QuickTalkState) -> dict[str, object]:
+    session = state.session_state
+    result: dict[str, object] = {
+        "object_id": id(session),
+        "frame_index": getattr(session, "frame_index", None),
+    }
+    for name in ("hn", "cn"):
+        value = np.asarray(getattr(session, name, np.asarray([])))
+        result[f"{name}_shape"] = list(value.shape)
+        result[f"{name}_nonzero_count"] = int(np.count_nonzero(value))
+        result[f"{name}_l2"] = float(np.linalg.norm(value))
+    return result
+
