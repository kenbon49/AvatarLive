# ============================================================================
# SynLive 统一配置（根目录 .env）
# 所有部署脚本 + docker compose 只读这一个文件。复制为 .env 后填写。
# .env 已被 gitignore，不会提交。
# ============================================================================

# ---------- 密钥 ----------
# Azure TTS（出声必需；与 LiveTalking 共用同一把 key）
AZURE_SERVICE_KEY=
AZURE_SERVICE_REGION=eastasia
# 给 LiveTalking 容器用的别名（与 AZURE_SERVICE_KEY 同值）
AZURE_SPEECH_KEY=
AZURE_TTS_REGION=eastasia

# LiteLLM / GPT（问答必需）
LITELLM_LLM_API_KEY=
LITELLM_LLM_BASE_URL=https://litellm.zuzuche.com/v1
LLM_DEFAULT_MODEL_ID=llm-gpt
SERVER_TOTAL_LITELLM_MODEL=azure-gpt-5.4
SERVER_TOTAL_LITELLM_TEMPERATURE=1
SERVER_TOTAL_MUSETALK_FPS=15
SERVER_TOTAL_MUSETALK_BATCH_SIZE=4
SERVER_TOTAL_MUSETALK_MAX_FRAME_HEIGHT=720
SERVER_TOTAL_MUSETALK_JPEG_QUALITY=92

# Nano Banana 形象编辑经 seo_video_generate 服务端代理调用；密钥只供容器间鉴权。
SEO_IMAGE_API_BASE_URL=http://host.docker.internal:8080
SEO_IMAGE_API_KEY=replace-with-a-random-service-key
SEO_IMAGE_MODEL=gemini-3.1-flash-image

# 百炼声音设计与 Fish Audio 参考音色查询；可与 SEO_IMAGE_API_* 共用同一服务和鉴权 key。
# 留空时 Web 服务自动回退到 SEO_IMAGE_API_BASE_URL / SEO_IMAGE_API_KEY。
SEO_VOICE_API_BASE_URL=http://host.docker.internal:8080
SEO_VOICE_API_KEY=replace-with-the-same-seo-service-key
# 服务器访问 Fish Audio CDN 需要代理时填写；可访问公网则留空。
HTTPS_PROXY=

# HappyHorse 动态底片生成与 MuseTalk 动态注册。
SEO_VIDEO_API_BASE_URL=http://host.docker.internal:8080
SEO_VIDEO_API_KEY=replace-with-the-same-seo-service-key
SEO_VIDEO_MODEL=happyhorse-1.0-video-edit
SEO_VIDEO_FALLBACK_MODEL=doubao-seedance-2-5-260628
AVATAR_REGISTRY_KEY=replace-with-a-second-random-service-key
AVATAR_ASSET_HOST_DIR=/data/llm_model/AvatarLive/runtime/avatar-assets
AVATAR_BASE_VIDEO_HOST_DIR=/data/llm_model/AvatarLive-backend/data/public
MUSETALK_ADMIN_DOCKER_UPSTREAM=http://host.docker.internal:8083

# ---------- 部署 / 网络 ----------
# 浏览器访问入口：机器 IP + Caddy 端口
ACCESS_HOST=your-server-ip
ACCESS_PORT=8018
# 后端访问 LiveTalking；单机部署用 host-gateway，本机无 LiveTalking 时自动降级
# 注意端口要和 deploy-livetalking.sh 的 LT_PORT 一致（默认 8028，不是 8010）
LIVETALKING_URL=http://host.docker.internal:8028
# 同源访问 CORS（保险）
CORS_ORIGINS=http://your-server-ip:8018

# ---------- 渲染后端（数字人驱动，可切换）----------
# unreal=UE5 MetaHuman 3D（默认）；livetalking=旧 2D 降级路径
RENDERER_BACKEND=unreal
NEXT_PUBLIC_RENDERER_BACKEND=unreal
# 可选：UE 工程若额外开了 HTTP 接口（后端兜底驱动）才填。datachannel 模式（默认）留空——
# 驱动由前端 emitUIInteraction 经 Pixel Streaming datachannel 完成，见 infra/docs/pixel-streaming-deploy.md。
UE_RENDER_URL=
# 浏览器直连 UE Pixel Streaming 信令服务器（SignalingServer 默认监听 :8888）
NEXT_PUBLIC_PIXELSTREAMING_URL=ws://your-server-ip:8888

# ---------- FlashHead Lite 实时高保真数字人（独立端口，不替换 LiveTalking :8028）----------
# 前端 /flashhead-api/* 经 Next 同源代理到 FlashHead；服务建议在 GPU 0、宿主机 :8030 运行。
FLASHHEAD_UPSTREAM=http://localhost:8030
# Docker web 容器访问宿主机服务时使用。
FLASHHEAD_DOCKER_UPSTREAM=http://host.docker.internal:8030
# 仅页面状态说明用；留空时自动显示“当前页面主机名:8030”。
NEXT_PUBLIC_FLASHHEAD_URL=
# 宿主机渲染服务启动参数（scripts/run-flashhead-demo.sh）。
FLASHHEAD_PORT=8030
FLASHHEAD_GPU=0
FLASHHEAD_START_BUFFER_SECONDS=0.10
FLASHHEAD_ROOT=/data/llm_model/cyberverse
FLASHHEAD_PYTHON=/home/super/miniconda3/envs/cyberverse/bin/python
# 生产环境必须换成已获得肖像授权的图片。
FLASHHEAD_FACE=/data/llm_model/cyberverse/cv_assets/face.jpg
FLASHHEAD_AVATAR_DIR=/data/llm_model/SynLive/public/assets/flashhead-avatars

# ---------- MuseTalk 1.5 真人动作主播（独立端口，不替换 :8028/:8030）----------
# 前端 /musetalk-api/* 经 Next 同源代理到 MuseTalk；宿主机服务建议独占一张 GPU。
MUSETALK_UPSTREAM=http://localhost:8031
MUSETALK_DOCKER_UPSTREAM=http://host.docker.internal:8031
# 仅页面状态说明用；留空时自动显示“当前页面主机名:8031”。
NEXT_PUBLIC_MUSETALK_URL=
# HTTPS 或跨机部署时可显式指定浏览器可访问的 WebSocket 地址；留空则自动选择。
NEXT_PUBLIC_MUSETALK_STREAM_URL=
# AvatarLive-backend/server_total 总流程；本机部署因端口冲突暴露在 :8085。
MUSETALK_TOTAL_UPSTREAM=http://host.docker.internal:8085
MELOTTS_UPSTREAM=http://localhost:8084
MUSETALK_STREAM_UPSTREAM=http://localhost:8083
# 留空时统一使用同源 /musetalk-total-api WebSocket 反代。
NEXT_PUBLIC_MUSETALK_TOTAL_URL=
# server_total 首帧播放缓冲，吸收 GPU 批次生成抖动。
NEXT_PUBLIC_MUSETALK_PLAYBACK_BUFFER_MS=1500
# 宿主机渲染服务启动参数（scripts/run-musetalk-demo.sh）。
MUSETALK_PORT=8031
MUSETALK_GPU=2
MUSETALK_BATCH_SIZE=8
MUSETALK_START_BUFFER_SECONDS=0.12
MUSETALK_ROOT=/data/MuseTalk
MUSETALK_PYTHON=/home/super/miniconda3/envs/cyberverse/bin/python
MUSETALK_AVATAR_CATALOG=/data/llm_model/SynLive/public/assets/musetalk-body/manifest.json
MUSETALK_BODY_MANIFEST=/data/llm_model/SynLive/public/assets/musetalk-body/motion-host/manifest.json
MUSETALK_CACHE_PATH=/data/MuseTalk/results/synlive-cache/motion-host-v15.npz

# ---------- LiveAct 生成式数字人（live-console 的「LiveAct 模式」，与实时路径并存）----------
# 前端 /liveact-api/* 经 next.config.ts rewrite 同源代理到 demo.py（绕 CORS+混合内容，不改 demo.py）。
# dev 同机：http://localhost:5071；容器内部署：host.docker.internal:5071（demo 跑在 host）；跨机：GPU 机 IP。
LIVEACT_UPSTREAM=http://localhost:5071
# Docker web 容器不能用 localhost 访问宿主机；compose 构建和运行时读取此项。
LIVEACT_DOCKER_UPSTREAM=http://host.docker.internal:5071
# 仅状态栏展示用（不参与 fetch）；填浏览器能直达的 demo 地址，如 http://your-server-ip:5071
NEXT_PUBLIC_LIVEACT_DEMO_URL=http://your-server-ip:5071

# 私有镜像仓库前缀（带尾斜杠）；内网拉不到 Docker Hub 时填，否则留空用 Docker Hub
REGISTRY=harbor-develop.zuzuche.net/dockerhub/
# npm/corepack 源（前端构建用）；国内默认 npmmirror，公网畅通可改 https://registry.npmjs.org/
NPM_REGISTRY=https://registry.npmmirror.com

# ---------- 数据库口令（默认即可，按需改）----------
POSTGRES_USER=synlive
POSTGRES_PASSWORD=synlive
POSTGRES_DB=synlive
# 本地运行 API 时使用；Docker Compose 会覆盖为 postgres 容器地址。
DATABASE_URL=postgresql+psycopg://synlive:synlive@localhost:5432/synlive
# 生成方式：python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 生产环境通过 Secret Manager 注入，切勿提交真实值；轮换前需先重加密已有凭据。
PLATFORM_ENCRYPTION_KEY=
# 仅本地联调可临时启用测试画面源；生产环境保持 false，真实媒体网关接入后再开播。
LIVE_RUN_ALLOW_TEST_PATTERN=false
MEDIA_SUPERVISOR_ENABLED=true
# API container -> SRS internal RTMP endpoint. Start SRS with the `media` profile.
SRS_INTERNAL_RTMP_URL=rtmp://srs:1935/live
# Host 8080 may be occupied by another service; SRS HTTP-FLV is exposed on 18080 by default.
SRS_HTTP_PORT=18080

# ---------- LiveTalking 部署参数（仅 RENDERER_BACKEND=livetalking 时需要；默认 unreal 不用）----------
MODEL=musetalk
# TTS：默认 azure（走 REST、复用 AZURE_SPEECH_KEY，需挂载 infra/livetalking/ttsreal_azure.py）。
#      edgetts 会被微软封 token 返回 403（数字人无声、嘴不动），仅留作对照。
TTS=azure
# AZURE_TTS_VOICE=zh-CN-XiaoxiaoNeural   # 可选：覆盖数字人音色（zh-CN-XiaoyiNeural / zh-CN-YunxiNeural …）
# SRS_HOST=        # 推流到 SRS 时填 SynLive 主机 IP；否则留空
