# ============================================================================
# SynLive 统一配置（根目录 .env）
# 首次部署脚本会从本模板生成 .env，再填写实际使用的云服务凭据。
# .env 已被 gitignore，不会提交。
# ============================================================================

# ---------- 密钥 ----------
# 阿里云灵眸播报视频（2025-05-27，仅服务端读取）。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_LINGMOU_TEMPLATE_ID=
ALIYUN_LINGMOU_REGION_ID=cn-beijing
ALIYUN_LINGMOU_ENDPOINT=lingmou.cn-beijing.aliyuncs.com
# 模板未声明变量时使用以下默认名称；如模板名称不同可覆盖。
ALIYUN_LINGMOU_TEXT_VARIABLE_NAME=text
# 供应商余额监控与数字人成本参数（单位为微元；1 元 = 1000000 微元）。
ALIYUN_BALANCE_CACHE_SECONDS=600
ALIYUN_LOW_BALANCE_MICROS=50000000
ALIYUN_VIDEO_MICROS_PER_SECOND=100000

# LLM（问答必需）；也可在管理员系统设置中保存 URL、Key 和模型。
# 后台保存的配置优先于环境变量。兼容旧 LITELLM_LLM_* 变量名。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_DEFAULT_MODEL_ID=deepseek-flash
# DeepSeek 中国区峰谷价。若 LiteLLM 网关合同价不同，按模型配置人民币/百万 Token：
# LLM_PRICING_OVERRIDE_JSON={"deepseek-v4-flash":{"peak":{"cache_hit":0.04,"cache_miss":2,"output":8},"off_peak":{"cache_hit":0.02,"cache_miss":1,"output":4}}}
# 中国法定节假日（北京日期，逗号分隔）按低峰价处理。
DEEPSEEK_HOLIDAY_DATES=
BILLING_MARKUP_BASIS_POINTS=10000
BILLING_MIN_CHARGE_MICROS=1

# 百炼语音试听和直播素材文件解析服务。
SEO_VOICE_API_BASE_URL=http://host.docker.internal:8080
SEO_VOICE_API_KEY=
# 服务器访问公网 API 需要代理时填写；可直接访问公网则留空。
HTTPS_PROXY=

# ---------- 部署 / 网络 ----------
# 浏览器访问入口：机器 IP + Caddy 端口
ACCESS_HOST=localhost
ACCESS_PORT=8018
# 数据库/缓存/内部 API 等管理端口默认仅宿主机可访问。
DATA_BIND_HOST=127.0.0.1
# 同源访问 CORS（保险）
CORS_ORIGINS=http://localhost:8018

# 私有镜像仓库前缀（带尾斜杠）；内网拉不到 Docker Hub 时填，否则留空用 Docker Hub
REGISTRY=
# npm/corepack 源（前端构建用）；国内默认 npmmirror，公网畅通可改 https://registry.npmjs.org/
NPM_REGISTRY=https://registry.npmmirror.com

# ---------- 独立 PostgreSQL 部署 ----------
# 先运行 deploy-postgres.sh（Windows 为 deploy-postgres.ps1），再部署应用。
POSTGRES_USER=synlive
POSTGRES_PASSWORD=
POSTGRES_DB=synlive
POSTGRES_PORT=5432
POSTGRES_DOCKER_NETWORK=synlive-database
# 保持旧部署的 volume 名，升级时不会创建一份空数据库。
POSTGRES_VOLUME_NAME=synlive_postgres_data
# 本地管理脚本访问独立 PostgreSQL 时使用；应用容器通过数据库网络访问 postgres:5432。
DATABASE_URL=
# 生成方式：python -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# 生产环境通过 Secret Manager 注入，切勿提交真实值；轮换前需先重加密已有凭据。
PLATFORM_ENCRYPTION_KEY=
# 空数据库首次启动时自动创建且仅创建一个管理员。随机密码保存在
# api_runtime volume，可通过部署脚本显示；请妥善保存随机初始密码。
BOOTSTRAP_ADMIN_EMAIL=admin@avatarlive.app
BOOTSTRAP_ADMIN_USERNAME=admin
# 仅本地联调可临时启用测试画面源；生产开播使用 browser_ingest，保持 false。
LIVE_RUN_ALLOW_TEST_PATTERN=false
MEDIA_SUPERVISOR_ENABLED=true
# API container -> SRS internal RTMP endpoint. Start SRS with the `media` profile.
SRS_INTERNAL_RTMP_URL=rtmp://srs:1935/live
SRS_INTERNAL_API_URL=http://srs:1985
# SRS WebRTC candidate must be reachable from viewers' browsers.
SRS_CANDIDATE=127.0.0.1
SRS_PUBLIC_WHIP_PATH=/rtc/v1/whip/
MEDIA_INGEST_WAIT_TIMEOUT=30
MEDIA_INGEST_DISCONNECT_GRACE_SECONDS=30
# Host 8080 may be occupied by another service; SRS HTTP-FLV is exposed on 18080 by default.
SRS_HTTP_PORT=18080
